# Export these in the shell that starts Aelix. This file is not auto-loaded.
AELIX_WEB_PROVIDER=auto
# With no settings, auto uses DuckDuckGo Lite. To force keyless search:
# AELIX_WEB_PROVIDER=duckduckgo
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
# AELIX_WEB_SEARXNG_URL=http://127.0.0.1:8080
# AELIX_WEB_OFFLINE=1
